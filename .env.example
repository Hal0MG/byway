# Roadtrip Planner settings. You don't need to edit this by hand: start the app and use Setup (the gear button),
# which checks each key and writes the .env file for you. This file only shows what goes in it.

# Routes and drive times (needed). Free key, no card: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# The trip planner AI: "local" (LM Studio on this PC, free and unlimited, needs a good GPU) or "gemini"
AI_PROVIDER=local
# For AI_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey (about 20 plans a day)
GEMINI_API_KEY=

# Web search while planning (optional). Free, 1,000 searches a month: https://app.tavily.com
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=900

# Your email or a web address, so Wikipedia and OpenStreetMap don't throttle photo lookups (recommended).
CONTACT=

PORT=3000
