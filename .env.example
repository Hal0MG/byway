# Byway settings. You don't need to edit this by hand: start the app and use Setup (the gear button),
# which checks each key and writes the .env file for you. This file only shows what goes in it.

# Routes and drive times (recommended). Free key, no card: https://openrouteservice.org/dev/#/signup
# Without it, or when its daily allowance runs out, routes come from OSRM (below), without elevation.
ORS_API_KEY=

# The trip planner AI: Google Gemini. Free key: https://aistudio.google.com/apikey (Flash-Lite: a plan in seconds,
# a daily limit)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest

# Web search while planning (optional). Free, 1,000 searches a month: https://app.tavily.com
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=900

# Your email or a web address, so Wikipedia and OpenStreetMap don't throttle photo lookups (recommended).
CONTACT=

PORT=3000

# Backup routing when OpenRouteService can't answer, and OpenStreetMap search servers (comma separated, tried in order)
# OSRM_URLS=https://routing.openstreetmap.de/routed-car,https://router.project-osrm.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter
