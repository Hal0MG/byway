{
  "distance_influence": 10,
  "priority": [
    { "if": "road_class == MOTORWAY", "multiply_by": "0.15" },
    { "else_if": "road_class == TRUNK", "multiply_by": "0.5" },
    { "else_if": "road_class == TRACK || road_class == SERVICE", "multiply_by": "0.1" },
    { "else_if": "road_class == RESIDENTIAL || road_class == LIVING_STREET", "multiply_by": "0.4" },

    { "if": "urban_density == CITY", "multiply_by": "0.4" },
    { "else_if": "urban_density == RESIDENTIAL", "multiply_by": "0.7" },

    { "if": "curvature >= 0.98", "multiply_by": "0.5" },
    { "else_if": "curvature >= 0.9", "multiply_by": "0.8" },

    { "if": "surface == DIRT || surface == GRAVEL || surface == SAND || surface == GROUND || surface == UNPAVED", "multiply_by": "0.2" },
    { "if": "toll == ALL", "multiply_by": "0.6" }
  ]
}
